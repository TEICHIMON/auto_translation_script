# 音频文件根目录(包含 /English/ 和 /Japanese/ 文件夹)
ROOT_DIR=/Users/yourname/audio-processing

# 同步目录(可选)
SYNC_DIR=/Users/yourname/phone-sync

# ============ 翻译模型配置 ============
# 翻译供应商:openai | claude | openrouter | deepseek
# 留空时会根据 CURRENT_MODEL 自动推断
TRANSLATION_PROVIDER=openai

# 当前使用的模型
CURRENT_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Claude
CLAUDE_API_KEY=sk-ant-api03-your-api-key-here
CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# ============ Whisper STT (本地 4060 GPU 服务器) ============
# 总开关:false 时遇到无字幕音频会直接跳过
ENABLE_WHISPER_STT=true

# Whisper 服务器地址(局域网)
WHISPER_SERVER_URL=http://192.168.31.50:8000

# 模型变体:default | large-v3
WHISPER_MODEL=default

# 跑完后自动通知服务端释放显存(true 推荐)
WHISPER_AUTO_RELEASE=true

# ============ LRC 分句 ============
# heuristic: 使用 Whisper 服务器生成的 LRC
# llm: 使用 DeepSeek 根据 word timestamps 重新分句,再本地重建时间戳
LRC_SEGMENTATION_MODE=heuristic
LRC_SEGMENTATION_MODEL=deepseek-v4-flash
LRC_SEGMENTATION_CHUNK_WORDS=900
