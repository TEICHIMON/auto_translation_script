# 音频文件根目录（包含 /英文/ 和 /日文/ 文件夹）
ROOT_DIR=/Users/你的用户名/音频处理

# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# OpenRouter 模型（默认使用 Gemini 2.0 Flash）
# 其他可选模型：
# - google/gemini-2.0-flash-exp:free (免费版本)
# - google/gemini-pro-1.5 (付费版本，更稳定)
# - anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
SYNC_DIR=