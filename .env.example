# 音频文件根目录（包含 /English/ 和 /Japanese/ 文件夹）
ROOT_DIR=/Users/你的用户名/音频处理

# 同步目录（可选）
SYNC_DIR=/Users/你的用户名/手机同步

# ============ 模型配置 ============
# 当前使用的模型 - 修改这个变量来切换不同的 API
# 示例:
#   - gpt-4o-mini, gpt-4o, gpt-3.5-turbo (OpenAI)
#   - claude-sonnet-4-20250514, claude-3-5-haiku-20241022 (Claude)
#   - google/gemini-2.5-flash, google/gemini-2.0-flash-exp:free (OpenRouter)
CURRENT_MODEL=gpt-4o-mini

# ============ OpenAI 配置 ============
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# ============ Claude 配置 ============
CLAUDE_API_KEY=sk-ant-api03-your-api-key-here
CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# ============ OpenRouter 配置 ============
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# ============ Google STT 配置 ============
# STT 总开关：true 开启，false 关闭（关闭时遇到无字幕音频会直接跳过）
ENABLE_GOOGLE_STT=true

# GCS 中转存储桶名称（确保在 Google Cloud 控制台提前创建好这个 Bucket）
GCS_BUCKET_NAME=your-audio-temp-bucket

# Google Cloud 服务账号密钥文件的绝对路径
GOOGLE_APPLICATION_CREDENTIALS=/绝对路径/你的/google-cloud-key.json