{
  "name": "subtitle-automation",
  "version": "1.0.0",
  "description": "自动化字幕翻译工具:SRT/Whisper -> 双语 LRC",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "translate": "node dist/translate-lrc.js",
    "sync": "node dist/sync-only.js",
    "convert": "node dist/convert-only.js",
    "dev": "ts-node src/index.ts",
    "dev:translate": "ts-node src/translate-lrc.ts",
    "dev:sync": "ts-node src/sync-only.ts",
    "dev:convert": "ts-node src/convert-only.ts"
  },
  "keywords": [
    "subtitle",
    "lrc",
    "srt",
    "translation",
    "whisper"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}